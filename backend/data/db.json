{
  "ejercicios": {
    "m1": {
      "materia": "matematicas",
      "tema": "Fracciones · mismo denominador",
      "enunciado": "6/6 + 9/6 = ?",
      "tipo": "fraccion",
      "respuestaCorrecta": "15/6",
      "pistaError": "Si el denominador es igual, se deja igual y solo se suman los numeradores."
    },
    "m2": {
      "materia": "matematicas",
      "tema": "Fracciones · mismo denominador",
      "enunciado": "22/25 + 15/25 = ?",
      "tipo": "fraccion",
      "respuestaCorrecta": "37/25",
      "pistaError": "Revisa si sumaste correctamente los numeradores (el denominador no cambia)."
    },
    "m3": {
      "materia": "matematicas",
      "tema": "Fracciones · Carita Sonriente",
      "enunciado": "2/5 + 3/10 = ?",
      "tipo": "fraccion",
      "respuestaCorrecta": "7/10",
      "pistaError": "Denominador diferente: aplica la regla de la carita sonriente (multiplica en cruz) antes de sumar."
    },
    "m4": {
      "materia": "matematicas",
      "tema": "Fracciones · Carita Sonriente",
      "enunciado": "3/8 + 5/4 = ?",
      "tipo": "fraccion",
      "respuestaCorrecta": "13/8",
      "pistaError": "Recuerda multiplicar en cruz los numeradores con el denominador contrario, y los denominadores entre sí."
    },
    "m5": {
      "materia": "matematicas",
      "tema": "Multiplicación de fracciones",
      "enunciado": "3/5 x 2/7 = ?",
      "tipo": "fraccion",
      "respuestaCorrecta": "6/35",
      "pistaError": "En la multiplicación no se busca denominador común: numerador por numerador, denominador por denominador."
    },
    "m6": {
      "materia": "matematicas",
      "tema": "Fracciones · mismo denominador",
      "enunciado": "25/25 + 15/25 = ?",
      "tipo": "fraccion",
      "respuestaCorrecta": "40/25",
      "pistaError": "Suma solo los numeradores y conserva el denominador si es igual."
    },
    "m7": {
      "materia": "matematicas",
      "tema": "Fracciones · mismo denominador",
      "enunciado": "170/100 + 80/100 = ?",
      "tipo": "fraccion",
      "respuestaCorrecta": "250/100",
      "pistaError": "Revisa si el denominador se mantiene igual en la suma con el mismo denominador."
    },
    "m8": {
      "materia": "matematicas",
      "tema": "Fracciones · Carita Sonriente",
      "enunciado": "5/2 + 7/9 = ?",
      "tipo": "fraccion",
      "respuestaCorrecta": "59/18",
      "pistaError": "Aplica la regla de la carita sonriente: multiplica en cruz y luego suma los resultados."
    },
    "m9": {
      "materia": "matematicas",
      "tema": "Fracciones · Carita Sonriente",
      "enunciado": "8/3 + 6/4 = ?",
      "tipo": "fraccion",
      "respuestaCorrecta": "50/12",
      "pistaError": "Recuerda encontrar un denominador común antes de sumar."
    },
    "m10": {
      "materia": "matematicas",
      "tema": "Graficar fracciones",
      "enunciado": "Grafica la fracción 2/5.",
      "tipo": "grafico",
      "respuestaCorrecta": "2/5",
      "pistaError": "Divide una figura en 5 partes y colorea 2."
    },
    "i1": {
      "materia": "ingles",
      "tema": "Verbo to be",
      "enunciado": "My brother ___ happy. (am / is / are)",
      "tipo": "texto",
      "respuestaCorrecta": "is",
      "pistaError": "\"My brother\" es él (singular) → usa la forma para he/she/it."
    },
    "i2": {
      "materia": "ingles",
      "tema": "Verbo to be",
      "enunciado": "Sofía and Pedro ___ friends. (am / is / are)",
      "tipo": "texto",
      "respuestaCorrecta": "are",
      "pistaError": "Cuando son varias personas (plural), el verbo to be usa la forma para we/they/you."
    },
    "i3": {
      "materia": "ingles",
      "tema": "Pronombres personales",
      "enunciado": "\"The dog and the cat\" → ¿qué pronombre los reemplaza?",
      "tipo": "texto",
      "respuestaCorrecta": "they",
      "pistaError": "Son varios (animales/cosas en plural) → el pronombre para varios es \"they\"."
    },
    "i4": {
      "materia": "ingles",
      "tema": "Pronombres personales",
      "enunciado": "\"Maria and I\" → ¿qué pronombre los reemplaza?",
      "tipo": "texto",
      "respuestaCorrecta": "we",
      "pistaError": "Cuando \"yo\" está incluido junto con otra persona, el pronombre es \"we\" (nosotros)."
    }
